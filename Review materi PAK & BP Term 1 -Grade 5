        function renderPGQuestion(index) {
            const q = pgQuestions[index];
            document.getElementById('q-title').innerText = q.title;
            document.getElementById('q-num-badge').innerText = q.id;
            document.getElementById('pg-progress-text').innerText = `Soal ${index + 1} dari ${pgQuestions.length}`;
            
            const progressPercent = ((index + 1) / pgQuestions.length) * 100;
            document.getElementById('pg-progress-bar').style.width = `${progressPercent}%`;

            const container = document.getElementById('q-options-container');
            container.innerHTML = '';

            const selected = currentUser.userAnswers[q.id] || [];
            const isEvaluated = currentUser.checkedQuestions[q.id] || false;

            q.options.forEach(opt => {
                const isChecked = selected.includes(opt.id);
                let borderStyle = "border-slate-200 hover:border-sky-300 bg-white";
                let badgeStyle = "bg-slate-100 text-slate-700";

                if (isEvaluated) {
                    if (opt.correct && isChecked) {
                        borderStyle = "border-emerald-500 bg-emerald-50/60 font-semibold";
                        badgeStyle = "bg-emerald-500 text-white";
                    } else if (!opt.correct && isChecked) {
                        borderStyle = "border-red-400 bg-red-50/60";
                        badgeStyle = "bg-red-500 text-white";
                    } else if (opt.correct && !isChecked) {
                        borderStyle = "border-amber-400 bg-amber-50/60";
                        badgeStyle = "bg-amber-500 text-white";
                    }
                } else if (isChecked) {
                    borderStyle = "border-sky-500 bg-sky-50/50 shadow-sm";
                    badgeStyle = "bg-sky-500 text-white";
                }

                const optEl = document.createElement('label');
                optEl.className = `flex items-start gap-3 p-4 rounded-2xl border-2 transition cursor-pointer ${borderStyle}`;
                optEl.innerHTML = `
                    <input type="checkbox" name="q-${q.id}" value="${opt.id}" ${isChecked ? 'checked' : ''} ${isEvaluated ? 'disabled' : ''} 
                           onchange="toggleOption(${q.id}, '${opt.id}')" class="mt-0.5 w-5 h-5 rounded border-slate-300 text-sky-600 focus:ring-sky-500">
                    <div class="flex-1 text-xs sm:text-sm text-slate-800 leading-relaxed">
                        <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold mr-1.5 ${badgeStyle}">${opt.id}</span>
                        ${opt.text}
                    </div>
                `;
                container.appendChild(optEl);
            });

            // Navigation Button States
            document.getElementById('btn-prev-q').disabled = (index === 0);
            
            // Check explanation box
            const expBox = document.getElementById('q-explanation-box');
            if (isEvaluated) {
                expBox.classList.remove('hidden');
                displayExplanation(q, selected);
            } else {
                expBox.classList.add('hidden');
            }

            renderPGNavGrid();
        }

        function toggleOption(qId, optId) {
            playSound('click');
            if (!currentUser.userAnswers[qId]) {
                currentUser.userAnswers[qId] = [];
            }
            const arr = currentUser.userAnswers[qId];
            const idx = arr.indexOf(optId);
            if (idx > -1) {
                arr.splice(idx, 1);
            } else {
                arr.push(optId);
            }
            renderPGQuestion(currentQuestionIdx);
        }

        function prevQuestion() {
            if (currentQuestionIdx > 0) {
                currentQuestionIdx--;
                renderPGQuestion(currentQuestionIdx);
            }
        }
        function nextQuestion() {
            if (currentQuestionIdx < pgQuestions.length - 1) {
                currentQuestionIdx++;
                renderPGQuestion(currentQuestionIdx);
            } else {
                showToast("Kamu berada di nomor terakhir!");
            }
        }

        function renderPGNavGrid() {
            const grid = document.getElementById('q-nav-grid');
            grid.innerHTML = '';
            pgQuestions.forEach((q, idx) => {
                const isCurrent = (idx === currentQuestionIdx);
                const isChecked = currentUser.checkedQuestions[q.id];
                const hasSelected = currentUser.userAnswers[q.id] && currentUser.userAnswers[q.id].length > 0;

                let btnStyle = "bg-slate-100 text-slate-600 hover:bg-slate-200";
                if (isCurrent) {
                    btnStyle = "bg-sky-600 text-white font-bold ring-2 ring-sky-300";
                } else if (isChecked) {
                    btnStyle = "bg-emerald-100 text-emerald-800 font-bold border border-emerald-300";
                } else if (hasSelected) {
                    btnStyle = "bg-amber-100 text-amber-800 font-bold border border-amber-300";
                }

                const btn = document.createElement('button');
                btn.className = `w-8 h-8 sm:w-9 sm:h-9 rounded-xl text-xs flex items-center justify-center transition ${btnStyle}`;
                btn.innerText = q.id;
                btn.onclick = () => {
                    currentQuestionIdx = idx;
                    renderPGQuestion(currentQuestionIdx);
                };
                grid.appendChild(btn);
            });
        }

        function checkCurrentAnswer() {
            const q = pgQuestions[currentQuestionIdx];
            const selected = currentUser.userAnswers[q.id] || [];

            if (selected.length === 0) {
                showToast("Pilihlah minimal satu jawaban terlebih dahulu!", false);
                return;
            }

            currentUser.checkedQuestions[q.id] = true;

            const correctOptIds = q.options.filter(o => o.correct).map(o => o.id);
            const incorrectOptIds = q.options.filter(o => !o.correct).map(o => o.id);

            const pickedWrong = selected.some(id => incorrectOptIds.includes(id));
            const pickedCorrectCount = selected.filter(id => correctOptIds.includes(id)).length;

            if (!pickedWrong && pickedCorrectCount === correctOptIds.length) {
                currentUser.streak++;
                if (currentUser.streak > currentUser.maxStreak) currentUser.maxStreak = currentUser.streak;
                playSound('correct');
            } else if (!pickedWrong && pickedCorrectCount > 0) {
                currentUser.streak = 0;
                playSound('click');
            } else {
                currentUser.streak = 0;
                playSound('wrong');
            }

            updateTotalScore();
            renderPGQuestion(currentQuestionIdx);
        }

