            text.innerHTML = `
                <b>Kunci Jawaban Benar:</b> Option (${correctOptIds.join(', ')})<br>
                <b>Pembahasan Alkitab:</b> ${q.explanation}
            `;
        }

        function updateTotalScore() {
            let totalPGScore = 0;
            pgQuestions.forEach(q => {
                if (currentUser.checkedQuestions[q.id]) {
                    const selected = currentUser.userAnswers[q.id] || [];
                    const correctOptIds = q.options.filter(o => o.correct).map(o => o.id);
                    const incorrectOptIds = q.options.filter(o => !o.correct).map(o => o.id);

                    const pickedWrong = selected.some(id => incorrectOptIds.includes(id));
                    const pickedCorrectCount = selected.filter(id => correctOptIds.includes(id)).length;

                    if (!pickedWrong && pickedCorrectCount === correctOptIds.length) {
                        totalPGScore += 2;
                    } else if (!pickedWrong && pickedCorrectCount > 0) {
                        totalPGScore += 1;
                    }
                }
            });

            currentUser.score = totalPGScore;
            updateStatsUI();
        }

        function updateStatsUI() {
            document.getElementById('stat-score').innerText = `${currentUser.score} Poin`;
            document.getElementById('stat-streak').innerText = `Combo x${currentUser.streak}`;
        }

        function renderEssays() {
            const container = document.getElementById('essay-list-container');
            container.innerHTML = '';

            essayQuestions.forEach((e, idx) => {
                const userText = currentUser.essayAnswers[e.id] || '';
                const selfCheckState = currentUser.essaySelfEval[e.id] || [false, false, false];

                const card = document.createElement('div');
                card.className = "bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-md space-y-4";
                card.innerHTML = `
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <span class="bg-purple-100 text-purple-800 text-xs font-bold px-2.5 py-0.5 rounded-md">Soal Esai ${idx + 1}</span>
                            <h3 class="font-display text-lg font-bold text-slate-800 mt-1">${e.title}</h3>
                        </div>
                        <div class="w-8 h-8 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-xs shrink-0">
                            E${idx + 1}
                        </div>
                    </div>

                    <p class="text-xs sm:text-sm text-slate-700 leading-relaxed bg-slate-50 p-4 rounded-2xl border border-slate-100">
                        ${e.prompt}
                    </p>

                    <div class="text-xs text-amber-700 font-medium flex items-center gap-1.5">
                        <i class="fa-solid fa-lightbulb text-amber-500"></i> ${e.hint}
                    </div>

                    <div>
                        <textarea id="essay-input-${e.id}" oninput="saveEssayText(${e.id})" rows="4" 
                                  placeholder="Tuliskan jawaban reflektifmu di sini..." 
                                  class="w-full p-4 rounded-2xl border border-slate-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-200 text-xs sm:text-sm text-slate-800 custom-scrollbar outline-none transition">${userText}</textarea>
                    </div>

                    <div class="bg-purple-50/50 p-4 rounded-2xl border border-purple-100 space-y-2">
                        <h4 class="font-display font-bold text-xs text-purple-900">Rubrik Evaluasi Mandiri (Centang Poin Yang Ada Di Jawabanmu):</h4>
                        <div class="space-y-1.5">
                            ${e.checklist.map((item, cIdx) => `
                                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                    <input type="checkbox" ${selfCheckState[cIdx] ? 'checked' : ''} onchange="toggleEssayCheck(${e.id}, ${cIdx})" class="w-4 h-4 rounded text-purple-600 focus:ring-purple-400">
                                    <span>${item}</span>
                                </label>
                            `).join('')}
                        </div>
                    </div>

                    <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                        <summary class="flex items-center justify-between p-3.5 bg-slate-50 hover:bg-slate-100 cursor-pointer text-xs font-bold text-slate-700 select-none">
                            <span><i class="fa-solid fa-key text-purple-500 mr-2"></i>Lihat Contoh Kunci Jawaban Lengkap</span>
                            <i class="fa-solid fa-chevron-down group-open:rotate-180 transition transform"></i>
                        </summary>
                        <div class="p-4 bg-white text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
                            ${e.modelAnswer}
                        </div>
                    </details>
                `;
                container.appendChild(card);
            });
        }

        function saveEssayText(essayId) {
            const val = document.getElementById(`essay-input-${essayId}`).value;
            currentUser.essayAnswers[essayId] = val;
        }

        function toggleEssayCheck(essayId, checkIdx) {
            if (!currentUser.essaySelfEval[essayId]) {
                currentUser.essaySelfEval[essayId] = [false, false, false];
            }
            currentUser.essaySelfEval[essayId][checkIdx] = !currentUser.essaySelfEval[essayId][checkIdx];
            playSound('click');
        }

        function finishAllTasks() {
            playSound('click');
            switchTab('result');
        }

        function calculateFinalResults() {
            let totalPGScore = 0;
            pgQuestions.forEach(q => {
                if (currentUser.checkedQuestions[q.id]) {
                    const selected = currentUser.userAnswers[q.id] || [];
                    const correctOptIds = q.options.filter(o => o.correct).map(o => o.id);
                    const incorrectOptIds = q.options.filter(o => !o.correct).map(o => o.id);

                    const pickedWrong = selected.some(id => incorrectOptIds.includes(id));
                    const pickedCorrectCount = selected.filter(id => correctOptIds.includes(id)).length;

                    if (!pickedWrong && pickedCorrectCount === correctOptIds.length) {
                        totalPGScore += 2;
                    } else if (!pickedWrong && pickedCorrectCount > 0) {
                        totalPGScore += 1;
                    }
                }
            });

            let totalEssayScore = 0;
            essayQuestions.forEach(e => {
                const checks = currentUser.essaySelfEval[e.id] || [false, false, false];
                const checkedCount = checks.filter(c => c).length;
                totalEssayScore += (checkedCount * 2.66);
            });

            const finalScoreVal = Math.min(100, Math.round(((totalPGScore / 60) * 70) + ((totalEssayScore / 40) * 30)));
            const accuracyVal = Math.round((totalPGScore / 60) * 100);

            document.getElementById('res-final-score').innerText = finalScoreVal;
            document.getElementById('res-pg-score').innerText = `${totalPGScore} / 60 Poin`;
            document.getElementById('res-accuracy').innerText = `${accuracyVal}%`;

            let predicate = "Prajurit Iman";
            let predicateColor = "text-amber-600";
            if (finalScoreVal >= 90) {
                predicate = "Pemanah Ulung Kebenaran";
                predicateColor = "text-emerald-600";
            } else if (finalScoreVal >= 75) {
                predicate = "Laskar Kristus yang Setia";
                predicateColor = "text-sky-600";
            }
            document.getElementById('res-predicate').innerText = predicate;
            document.getElementById('res-predicate').className = `font-display text-xl font-bold mt-1 ${predicateColor}`;

            renderBadges(finalScoreVal, accuracyVal);
        }

        function renderBadges(finalScore, accuracy) {
            const container = document.getElementById('badges-container');
            container.innerHTML = '';

            const badges = [
                { title: "🎯 Pemanah Ulung", desc: "Memahami Arti Hamartia", unlocked: true },
                { title: "🌱 Manusia Baru", desc: "Meninggalkan The Old Me", unlocked: true },
                { title: "📖 Ahli Kitab", desc: "Akurasi > 70%", unlocked: accuracy >= 70 },
                { title: "⭐ Bintang Iman", desc: "Nilai Akhir > 85", unlocked: finalScore >= 85 }
            ];

            badges.forEach(b => {
                const badgeEl = document.createElement('div');
                badgeEl.className = `px-3.5 py-2 rounded-2xl border text-xs font-bold flex items-center gap-2 ${
                    b.unlocked ? 'bg-amber-50 border-amber-300 text-amber-900 shadow-sm' : 'bg-slate-100 border-slate-200 text-slate-400 opacity-50'
                }`;
                badgeEl.innerHTML = `
                    <span>${b.unlocked ? '🏆' : '🔒'}</span>
                    <div>
                        <div>${b.title}</div>
                        <div class="text-[10px] font-normal text-slate-500">${b.desc}</div>
                    </div>
                `;
                container.appendChild(badgeEl);
            });
        }

        function restartQuiz() {
            if (confirm("Apakah kamu ingin mengulang petualangan game dari awal?")) {
                currentUser.score = 0;
                currentUser.streak = 0;
                currentUser.userAnswers = {};
                currentUser.checkedQuestions = {};
                currentUser.essayAnswers = {};
                currentUser.essaySelfEval = {};
                currentQuestionIdx = 0;

                renderPGQuestion(0);
                renderPGNavGrid();
                renderEssays();
                updateStatsUI();
                switchTab('pg');
                showToast("Petualangan diulang dari awal!");
            }
        }
    </script>
</body>
</html>
